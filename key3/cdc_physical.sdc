create_clock -name scan_fast -period 4.081633 -waveform {1.020408 3.061224} [get_ports {scan_fast}]
create_clock -name pixel_clk -period 20.408163 [get_ports {pixel_clk}]
set_false_path -from [get_ports {pixel_locked}]
create_clock -name clk_25m -period 40.000 [get_ports {clk_25m}]
create_clock -name core_clk -period 10.000 [get_ports {core_clk}]
create_clock -name clk_100m -period 10.000 [get_ports {clk_100m}]
create_clock -name sdram_clk -period 2.500 [get_ports {sdram_clk}]
create_clock -name rx_cal_clk -period 2.500 [get_ports {rx_cal_clk}]
create_clock -name tx_cal_clk -period 2.500 [get_ports {tx_cal_clk}]
create_clock -name tx_cal_clk_90edge -period 2.500 [get_ports {tx_cal_clk_90edge}]
create_clock -name jtag_inst1_TCK -period 1000.000 [get_ports {jtag_inst1_TCK}]
# Separate PLL/calibration domains follow the supplied controller's CDC model;
# phase shifts are adjusted by training. This is not independent CDC signoff.
set_clock_groups -asynchronous -group {core_clk pixel_clk} -group {sdram_clk clk_100m} -group {rx_cal_clk} -group {tx_cal_clk tx_cal_clk_90edge} -group {jtag_inst1_TCK} -group {clk_25m} -group {scan_fast}
set_false_path -from [get_ports {system_uart_0_io_rxd pll_locked user_pll_locked}]
set_output_delay -clock core_clk -max 0.000 [get_ports {system_uart_0_io_txd ddr_reset_n}]
set_output_delay -clock core_clk -min 0.000 [get_ports {system_uart_0_io_txd ddr_reset_n}]
set_input_delay -clock jtag_inst1_TCK -max 0.000 [get_ports {jtag_inst1_TDI}]
set_input_delay -clock jtag_inst1_TCK -min 0.000 [get_ports {jtag_inst1_TDI}]
# Bound the registered phase-control command arrival to one controller clock.
set_output_delay -clock core_clk -max 0.000 [get_ports {pll_shift[*] pll_shift_sel[*] pll_shift_ena}]
set_output_delay -clock core_clk -min 0.000 [get_ports {pll_shift[*] pll_shift_sel[*] pll_shift_ena}]
set_false_path -from [get_ports {key_n[*]}]


# Gray pointer bus skew must remain below the respective source clock period.
# Wildcard startpoints retain coverage if a Gray MSB merges with binary MSB.
set_bus_skew -from [get_pins {scanout/fifo/wg[*]~FF|CLK}] -to [get_pins {scanout/fifo/wg1[*]~FF|D}] 10.000
set_bus_skew -from [get_pins {scanout/fifo/rg[*]~FF|CLK}] -to [get_pins {scanout/fifo/rg1[*]~FF|D}] 20.408163
# Bundled payload/control: a <=10ns relative skew is smaller than the two
# destination-clock synchronizer cycles before the mailbox payload capture.
set_bus_skew -from [get_pins {scan_monitor/mailbox/*~FF|CLK}] -to [get_pins {scan_monitor/received[*]~FF|D scan_monitor/mailbox/request_sync[0]~FF|D}] 10.000
set_bus_skew -from [get_pins {scanout/*~FF|CLK}] -to [get_pins {text_pixel_base[*]~FF|D scanout/pix_id[*]~FF|D scanout/desc_sync[0]~FF|D}] 20.408163
set_bus_skew -from [get_pins {scanout/*~FF|CLK}] -to [get_pins {front[*]~FF|D shown[*]~FF|D scanout/shown_sync[0]~FF|D}] 10.000

set_bus_skew -from [get_pins {text_layer/mailbox/*~FF|CLK}] -to [get_pins {text_layer/received[*]~FF|D text_layer/mailbox/request_sync[0]~FF|D}] 10.000

set_output_delay -clock jtag_inst1_TCK -max 1.519 [get_ports {jtag_inst1_TDO}]
set_output_delay -clock jtag_inst1_TCK -min 0.495 [get_ports {jtag_inst1_TDO}]
set_input_delay -clock_fall -clock jtag_inst1_TCK -max 0.144 [get_ports {jtag_inst1_CAPTURE}]
set_input_delay -clock_fall -clock jtag_inst1_TCK -min 0.077 [get_ports {jtag_inst1_CAPTURE}]
