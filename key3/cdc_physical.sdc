# Configuration Control Constraints
#####################################
set_output_delay -clock clk_25m -reference_pin [get_ports {clk_25m~CLKOUT~1~7}] -max 1.147 [get_ports {cfg_CBSEL[*]}]
set_output_delay -clock clk_25m -reference_pin [get_ports {clk_25m~CLKOUT~1~7}] -min -0.000 [get_ports {cfg_CBSEL[*]}]
set_output_delay -clock clk_25m -reference_pin [get_ports {clk_25m~CLKOUT~1~7}] -max 1.087 [get_ports {cfg_ENA}]
set_output_delay -clock clk_25m -reference_pin [get_ports {clk_25m~CLKOUT~1~7}] -min -0.000 [get_ports {cfg_ENA}]
# AN010 v2.5 p7 defines CONFIG as asynchronous. The RTL holds the request
# high, after two config-clock selection/capture cycles, until system reset.
set_false_path -to [get_ports {cfg_CONFIG}]
# ERROR has no specified launch clock: terminate the asynchronous exception
# ONLY at the first synchronizer. The second stage/APB paths remain timed.
set_false_path -from [get_ports {cfg_ERROR}] -to [get_pins {mirror_control/error_meta~FF|D}]
